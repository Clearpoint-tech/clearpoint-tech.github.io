---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign pages = site.pages | sort: "url" -%}
{%- for p in pages -%}
  {%- unless p.url == '/sitemap.xml' or p.url == '/robots.txt' or p.url == '/feed.xml' or p.url contains '/404' or p.url contains '/assets/' or p.sitemap == false -%}
  {%- assign p_lang = p.lang | default: site.lang -%}
  {%- assign t = site.data.i18n[p_lang] -%}
  {%- assign raw_path = p.url -%}
  {%- if t.prefix != "" -%}{%- assign raw_path = p.url | remove_first: t.prefix -%}{%- endif -%}
  {%- if raw_path == "" -%}{%- assign raw_path = "/" -%}{%- endif %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
    {%- unless p.multilingual == false -%}
      {%- for entry in site.data.i18n %}
    <xhtml:link rel="alternate" hreflang="{{ entry[0] }}" href="{{ entry[1].prefix | append: raw_path | absolute_url }}" />
      {%- endfor %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ raw_path | absolute_url }}" />
    {%- endunless %}
  </url>
  {%- endunless -%}
{%- endfor %}
</urlset>
